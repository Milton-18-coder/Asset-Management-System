# Server Configuration
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=asset_management_db

# AI Assistant Configuration (Hybrid Agent & Rule Engine)
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-flash
AI_MAX_TOKENS=4000
AI_LOW_TOKEN_THRESHOLD=800

# Email Dispatch Configuration (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASSWORD=your_smtp_password
REPORT_FROM_EMAIL=reports@assetms.campus.edu

# WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# Frontend OAuth (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
